{
  "info": {
    "_postman_id": "movie-streaming-api-auth",
    "name": "Movie Streaming API - Auth",
    "description": "Hoàn thành Auth API Collection để test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. REGISTER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser123\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123\",\n  \"fullName\": \"Test User\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "2. LOGIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "    pm.environment.set(\"userId\", jsonData.userId);",
              "    console.log('Đăng nhập thành công!');",
              "    console.log('Access Token: ' + jsonData.accessToken);",
              "    console.log('Refresh Token: ' + jsonData.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"testuser123\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "3. GET CURRENT USER",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/me",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "4. REFRESH TOKEN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "    console.log('Token được làm mới thành công!');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/refresh",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "refresh"]
        }
      },
      "response": []
    },
    {
      "name": "5. CHANGE PASSWORD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oldPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword456\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/change-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "change-password"]
        }
      },
      "response": []
    },
    {
      "name": "6. FORGOT PASSWORD",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var responseText = pm.response.text();",
              "    console.log('Response: ' + responseText);",
              "    // Extract token từ message: \"Reset token: abc123...\"",
              "    var match = responseText.match(/Reset token: ([^\"]+)/);",
              "    if (match && match[1]) {",
              "        var resetToken = match[1];",
              "        pm.environment.set(\"resetToken\", resetToken);",
              "        console.log('✅ Reset token extracted: ' + resetToken);",
              "    } else {",
              "        console.warn('⚠️ Could not extract reset token from response');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/forgot-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "forgot-password"]
        }
      },
      "response": []
    },
    {
      "name": "7. RESET PASSWORD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
