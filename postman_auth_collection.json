          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"ResetPassword789\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/reset-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "reset-password"]
        }
      },
      "response": []
    },
