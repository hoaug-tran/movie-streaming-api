            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Test Movie\", \"slug\": \"test-movie-unique\", \"description\": \"A test movie\", \"releaseYear\": 2024, \"movieType\": \"SINGLE\", \"movieStatus\": \"DRAFT\", \"isPremiumOnly\": false}"
