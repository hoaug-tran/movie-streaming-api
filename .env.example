# DATABASE CONFIGURATION
DATABASE_URL=jdbc:mysql://localhost:3306/movie_streaming_platform?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USER=root
DATABASE_PASSWORD=your_database_password_here

# JWT SECURITY
JWT_SECRET_KEY=your_jwt_secret_key_generated_by_openssl_rand_-base64_32
JWT_EXPIRATION_MS=86400000

# EMAIL CONFIGURATION (Mailtrap or other SMTP provider)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_EMAIL=noreply@giophim.com
MAIL_FROM_NAME=Gio Phim

# APPLICATION URLS
APP_BASE_URL=http://localhost:3000
APP_RESET_PASSWORD_URL=http://localhost:3000/reset-password?token=
APP_EMAIL_VERIFICATION_URL=http://localhost:3000/verify?email=

# LOGGING
LOG_LEVEL=INFO
LOG_LEVEL_AUTH=DEBUG
LOG_LEVEL_SECURITY=DEBUG

# SPRING PROFILE (local, staging, prod)
SPRING_PROFILES_ACTIVE=local

# OPTIONAL: Advanced Configuration

# Cache configuration
SPRING_CACHE_TYPE=simple

# Connection pool sizing
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# JPA/Hibernate
JPA_SHOW_SQL=false
JPA_HIBERNATE_DDL_AUTO=update

# Actuator (health checks, metrics)
MANAGEMENT_ENDPOINTS_WEB_INCLUDE=health,info,metrics
