# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=movie_streaming_platform
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password
MYSQL_PORT=3306

# API Configuration
API_PREFIX=/api/v1

# JWT Configuration (minimum 256-bit secret key for HS256)
JWT_SECRET_KEY=your-256-bit-secret-key-here-minimum-32-characters-required-for-hs256-algorithm
JWT_ACCESS_TOKEN_EXPIRATION=86400000
